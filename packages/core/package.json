{
  "name": "@font-tastic/core",
  "version": "0.2.1",
  "description": "Core typography detection, Google Fonts dynamic loading, and override engine for Font-Tastic",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "homepage": "https://fontastic.tech",
  "repository": {
    "type": "git",
    "url": "https://github.com/caballeropedro/font-tastic.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "test": "vitest run"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
