{
  "name": "font-tastic-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source in-app typography devtool with auto-detection for web projects",
  "scripts": {
    "dev": "pnpm --filter font-tastic-web dev",
    "build": "pnpm --filter \"@font-tastic/*\" build && pnpm --filter font-tastic-web build",
    "release": "pnpm --filter \"@font-tastic/*\" build && pnpm --filter \"@font-tastic/*\" publish --access public --no-git-checks",
    "test": "echo \"Running tests...\""
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@12.11.2"
}
